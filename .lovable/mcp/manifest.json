{
  "version": 1,
  "sdk_version": "0.20.0",
  "path": "/mcp",
  "auth": {
    "type": "none"
  },
  "mcp": {
    "server": {
      "name": "hba-mcp",
      "version": "0.1.0",
      "title": "HBA — Design Studio"
    },
    "tools": [
      {
        "name": "list_projects",
        "title": "List projects",
        "description": "List HBA projects with optional filtering by region, expertise discipline, or free-text query on title, studio, or location.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "region": {
              "description": "Filter by region, e.g. 'Europe', 'Middle East'.",
              "type": "string"
            },
            "expertise": {
              "description": "Filter by expertise discipline, e.g. 'Interiors', 'Resort'.",
              "type": "string"
            },
            "query": {
              "description": "Case-insensitive substring match against title, studio, and location.",
              "type": "string"
            },
            "limit": {
              "description": "Maximum number of results (default 50).",
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "get_project",
        "title": "Get project",
        "description": "Fetch full details for a single HBA project by its slug.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "slug": {
              "type": "string",
              "minLength": 1,
              "description": "Project slug, e.g. 'jumeirah-marsa-al-arab'."
            }
          },
          "required": [
            "slug"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "list_offices",
        "title": "List studios & offices",
        "description": "List HBA studio offices grouped by region.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "region": {
              "description": "Optional region name (e.g. 'EUROPE') to return offices for only that region.",
              "type": "string"
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "list_filters",
        "title": "List available filters",
        "description": "Return the available expertise disciplines and regions used to filter projects.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      }
    ]
  }
}
